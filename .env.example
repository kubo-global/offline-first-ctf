# Copy to .env and set real values before `docker compose up -d`.
# This file stays on the server and never goes in a repo.

# --- the event --------------------------------------------------------------------
# The name on the game site, the cards, the boxes and the AI helper.
EVENT_NAME=Capture the Flag
# One line under the name on the challenge board: who, where, when.
EVENT_TAGLINE=
# Flags look like FLAG{...}. Set it to the prefix your challenge pack uses.
FLAG_PREFIX=FLAG
# Logins are this word plus a number: player01, player02, ... Lowercase letters only.
LOGIN_PREFIX=player
# The challenge pack: a folder with catalog.py, files/, tutorials/ and web-challenge/.
PACK=./example-pack

# --- passwords --------------------------------------------------------------------
# The CTFd admin, used by provision.py and players.py.
CTFD_ADMIN_PASSWORD=change-me-admin
MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_PASSWORD=change-me-ctfd
# signs CTFd's session cookies; any long random text: openssl rand -hex 32
CTFD_SECRET_KEY=change-me-long-random

# The server's address on the CTF Wi-Fi. Goes into the challenge texts, the welcome
# text in every box and the table cards.
SERVER_ADDR=192.168.0.10

# Which address the services listen on. 0.0.0.0 (all) is right for the lab server;
# set the server's own address (192.168.0.10) to keep them off any other network it is
# on, such as the phone hotspot for the AI helper.
BIND_ADDR=0.0.0.0

# Always use the platform and the player boxes together.
COMPOSE_FILE=docker-compose.yml:docker-compose.players.yml

# The AI helper (optional). A Together AI key, made with a spending limit on it. Leave it
# empty and the helper says it is switched off. Any OpenAI-compatible provider works:
# set AI_BASE_URL and AI_MODEL too.
AI_API_KEY=
# AI_MODEL=openai/gpt-oss-120b
# AI_PER_HOUR=40
# AI_BUDGET_TOKENS=5000000
# tutor (hints, not flags) or assistant (plain answers)
# AI_MODE=tutor
# One sentence about your players, so the helper pitches its answers right.
# AI_AUDIENCE=Most players are students who are new to security.
